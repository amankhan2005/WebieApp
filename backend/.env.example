# ═══════════════════════════════════════════════════════
# WEBIEAPP SOLUTIONS LLC — SERVER ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB Atlas ────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers
# Format: mongodb+srv://user:password@cluster.mongodb.net/webieapp?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/webieapp

# ── Resend Email ─────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_EMAIL=hello@webieapp.com
FROM_EMAIL=noreply@webieapp.com
FROM_NAME=WebieApp Solutions LLC

# ── Anthropic / Claude AI ────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Authentication ────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-64-characters-long-random-string
JWT_EXPIRES_IN=7d

# Static admin key for direct API access (used in x-admin-key header)
ADMIN_SECRET_KEY=your-admin-secret-key-change-this

# ── Frontend ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CONTACT_RATE_LIMIT_MAX=5
CHAT_RATE_LIMIT_MAX=60
